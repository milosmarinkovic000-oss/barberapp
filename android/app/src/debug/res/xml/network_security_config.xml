<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug: Firebase Emulator Suite radi preko HTTP-a na računaru — 10.0.2.2 iz Android emulatora ili
  IP adresa računara u lokalnoj mreži za fizički telefon (-Ptermin.emulatorHost=...). Release build
  koristi glavnu konfiguraciju, koja HTTP ne dozvoljava.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Namerno: samo za lokalni demo backend; ovaj fajl ne ulazi u release build. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
